FROM gcc:12-bookworm AS builder
WORKDIR /build
COPY src/target/ ./
RUN g++ -std=c++20 -O2 -Wall -Wextra -Wpedantic -Werror -pthread timing.cpp main.cpp -o target_sim

FROM debian:bookworm-slim
COPY --from=builder /build/target_sim /usr/local/bin/target_sim
USER 10001:10001
ENTRYPOINT ["target_sim"]
