FROM python:3.11-slim-bookworm
WORKDIR /app
COPY pyproject.toml ./
COPY src/orchestrator ./src/orchestrator
RUN python -m pip install --no-cache-dir . && mkdir /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "orchestrator.cloud:app", "--host", "0.0.0.0", "--port", "8000"]
